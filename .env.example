OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_FREE_API_KEY=
# Claude は CLAUDE_API_KEY を読む (ANTHROPIC_API_KEY ではない —
# builtin_data/providers/anthropic.json / llm_clients/anthropic.py)。
CLAUDE_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
# Kimi / Moonshot などの自作プロバイダは、自分で決めたキー名を
# provider JSON の api_key_env に書く (docs/custom_providers.md)。

SAIMEMORY_DEBUG=false
# LLM_PROVIDER and LLM_MODEL are SAIMemory standalone legacy settings (unused in SAIVerse)
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash

# Behavior
SAIMEMORY_TEMPERATURE=1
SAIMEMORY_SYSTEM_PROMPT=
SAIMEMORY_SYSTEM_PROMPT_FILE=./prompts/system.txt

# Memory
SAIMEMORY_DB_PATH=memory.db
SAIMEMORY_MEMORY=on

# GPU Acceleration for Embeddings
# Set to 1 to enable CUDA, 0 to force CPU, or leave unset for auto-detection
# See docs/getting-started/gpu-setup.md for setup instructions
# SAIMEMORY_EMBED_CUDA=1
SAIMEMORY_MEMORY_LAST_MESSAGES=40
SAIMEMORY_MEMORY_SEMANTIC_RECALL=true
SAIMEMORY_MEMORY_TOPK=5
SAIMEMORY_MEMORY_RANGE_BEFORE=2
SAIMEMORY_MEMORY_RANGE_AFTER=2
SAIMEMORY_MEMORY_SCOPE=resource
# SAIMEMORY_EMBED_MODEL=intfloat/multilingual-e5-small
SAIMEMORY_MEMORY_CHUNK_MIN_CHARS=120
SAIMEMORY_MEMORY_CHUNK_MAX_CHARS=480

SAIVERSE_RECALL_SNIPPET_MAX_CHARS=8000
SAIVERSE_RECALL_SNIPPET_STREAM_MAX_CHARS=8000
SAIVERSE_RECALL_SNIPPET_PULSE_MAX_CHARS=8000

# Summary
SAIMEMORY_SUMMARY=false
SAIMEMORY_SUMMARY_PRERUN=false
SAIMEMORY_SUMMARY_MAX_CHARS=4000
# SAIMEMORY_SUMMARY_PROMPT_FILE is unused in current codebase

SAIVERSE_LOG_LEVEL=INFO

SDS_URL=http://127.0.0.1:8080

# Database Backup (saiverse.db)
# Automatically backup saiverse.db on startup (recommended: true)
SAIVERSE_DB_BACKUP_ON_START=true
# Number of backup copies to keep (default: 10)
SAIVERSE_DB_BACKUP_KEEP=10
# Number of validated pre-upgrade restore points to keep independently
SAIVERSE_DB_PREUPGRADE_BACKUP_KEEP=10

# SAIMemory Backup (per-persona memory.db)
# Automatically backup persona memory.db on startup (recommended: true)
SAIMEMORY_BACKUP_ON_START=true
# rdiff-backup path (optional, auto-detected if not specified)
# SAIMEMORY_RDIFF_PATH=/usr/bin/rdiff-backup

# SEA runtime debugging (optional)
# SAIVERSE_SEA_TRACE=1

# Spell system (optional)
# SAIVERSE_SPELL_MAX_ROUNDS=3  # Max sequential spell rounds per LLM response (default: 3)

# Discord Gateway (optional)
SAIVERSE_GATEWAY_ENABLED=0
SAIVERSE_GATEWAY_WS_URL=wss://example.com/ws
SAIVERSE_GATEWAY_TOKEN=
SAIVERSE_GATEWAY_CHANNEL_MAP={}
SAIVERSE_GATEWAY_MEMORY_CHUNK_SIZE=65536

# Image attachment embed limit (images beyond the limit are replaced with text summaries)
SAIVERSE_ATTACHMENT_LIMIT=4
# Provider-specific overrides (take precedence over the universal limit):
# SAIVERSE_GEMINI_ATTACHMENT_LIMIT=4
# SAIVERSE_OPENAI_ATTACHMENT_LIMIT=4
# SAIVERSE_ANTHROPIC_ATTACHMENT_LIMIT=4

# Image summary model (used when images cannot be embedded directly)
# SAIVERSE_IMAGE_SUMMARY_MODEL=gemini-3.1-flash-lite-preview

# Use attached media (image/audio/video) summaries as auto-recall search query input.
# ON adds a synchronous summary-generation wait (a few seconds) when media is attached.
# Default: false. Also settable from the UI (グローバル設定 > 環境).
SAIVERSE_MEDIA_RECALL_ENABLED=false
SAIVERSE_DISABLE_GEMINI_SSE_PATCH=0
SAIVERSE_DISABLE_GEMINI_STREAMING=0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourmail@gmail.com
SMTP_PASSWORD=
SMTP_FROM="SAIVerse"
SMTP_USE_TLS=true

# SAIVERSE_DEFAULT_LIGHTWEIGHT_MODEL=qwen/qwen3-next-80b-a3b-instruct
# SAIVERSE_DEFAULT_MODEL=mistralai/mistral-large-3-675b-instruct-2512

MEMORY_WEAVE_MODEL=gemini-3.1-flash-lite-preview
# BATCH_SIZE / CONSOLIDATION_SIZE を読むのは scripts/arasuji/ の一括生成
# スクリプトだけ (本体の編纂は 2026-07-21 に別方式へ世代交代した)。
MEMORY_WEAVE_BATCH_SIZE=20
MEMORY_WEAVE_CONSOLIDATION_SIZE=10

ENABLE_MEMORY_WEAVE_CONTEXT=false
GEMINI_TIMEOUT_SECONDS=180
# Observer push authentication token (required for /api/observer/{id}/push endpoint)
# OBSERVER_PUSH_TOKEN=your-secret-token-here

# LAN backend exposure (main.py --listen-host 0.0.0.0) requires both values.
# Use complete browser origins, comma-separated. Generate a long random owner token.
# SAIVERSE_OWNER_TOKEN=replace-with-a-long-random-secret
# SAIVERSE_ALLOWED_ORIGINS=http://192.168.1.100:3000,https://my-pc.example

# Files persisted in DB are restricted to managed SAIVerse roots. Add deliberate
# external mounts here using the OS path separator (semicolon on Windows, colon on Unix).
# SAIVERSE_EXTERNAL_FILE_ROOTS=D:\SAIVerseAssets;E:\SharedDocuments

# Provider endpoints resolving to private/non-global hosts require explicit host opt-in.
# SAIVERSE_PROVIDER_ALLOWED_HOSTS=llm.internal.example,192.168.1.50

# Addon catalog trust. The official catalog's Ed25519 public key is built into
# the app (saiverse/addon_registry.py DEFAULT_REGISTRY_PUBLIC_KEY); set this only
# to override it for a self-hosted registry.
# Value is the base64-encoded raw 32-byte Ed25519 public key.
# SAIVERSE_ADDON_REGISTRY_PUBLIC_KEY=
# SAIVERSE_ADDON_REGISTRY_URL=https://example.com/registry.json
# Unsigned third-party remote catalogs are disabled unless deliberately enabled:
# SAIVERSE_ALLOW_UNSIGNED_ADDON_REGISTRY=false

# Default: auto-detect text files and normalize line endings to LF on commit,
# check out as LF in working tree (cross-platform consistency).
* text=auto eol=lf

# Windows-only files: must keep CRLF in working tree to run correctly
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts: always LF (required by bash)
*.sh text eol=lf

# Source code (LF)
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.rs text eol=lf
*.go text eol=lf
*.java text eol=lf

# Data / config files (LF)
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.tsv text eol=lf

# Web assets (LF)
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.svg text eol=lf
*.xml text eol=lf


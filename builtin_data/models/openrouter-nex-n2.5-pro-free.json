{
  "model": "nex-agi/nex-n2.5-pro:free",
  "system_prompt": "",
  "display_name": "Nex N2.5 Pro (OpenRouter, Free)",
  "provider_ref": "openrouter",
  "group": "openrouter",
  "supports_structured_output": true,
  "context_length": 262144,
  "convert_system_to_user": true,
  "supports_images": true,
  "max_image_bytes": 7500000,
  "max_image_embeds": 4,
  "reasoning_passback_field": "reasoning_details",
  "request_kwargs": {
    "extra_body": {
      "reasoning": {
        "enabled": true
      }
    }
  },
  "parameters": {
    "temperature": {
      "type": "float",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 0.7,
      "label": "Temperature",
      "description": "Controls randomness."
    },
    "top_p": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.95,
      "label": "Top P",
      "description": "Nucleus sampling cutoff."
    },
    "max_tokens": {
      "type": "int",
      "min": 32,
      "max": 131072,
      "step": 1,
      "default": 8192,
      "label": "Max tokens",
      "description": "Upper bound on generated tokens."
    }
  }
}

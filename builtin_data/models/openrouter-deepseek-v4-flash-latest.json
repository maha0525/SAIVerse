{
  "model": "~deepseek/deepseek-v4-flash-latest",
  "system_prompt": "",
  "display_name": "DeepSeek V4 Flash Latest (OpenRouter)",
  "provider_ref": "openrouter",
  "group": "openrouter",
  "supports_structured_output": true,
  "context_length": 1048576,
  "convert_system_to_user": true,
  "supports_images": false,
  "reasoning_passback_field": "reasoning_details",
  "request_kwargs": {
    "extra_body": {
      "reasoning": {
        "enabled": true
      }
    }
  },
  "parameters": {
    "reasoning_effort": {
      "type": "enum",
      "options": [
        "low",
        "high",
        "max"
      ],
      "default": "high",
      "label": "Reasoning Effort",
      "description": "Controls how much reasoning the current alias target performs."
    },
    "temperature": {
      "type": "float",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1,
      "label": "Temperature",
      "description": "Controls randomness."
    },
    "top_p": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "label": "Top P",
      "description": "Nucleus sampling cutoff."
    },
    "max_tokens": {
      "type": "int",
      "min": 32,
      "max": 65536,
      "step": 1,
      "default": 8192,
      "label": "Max tokens",
      "description": "Upper bound on generated tokens."
    }
  },
  "pricing": {
    "input_per_1m_tokens": 0.079996,
    "cached_input_per_1m_tokens": 0.0252,
    "output_per_1m_tokens": 0.252,
    "currency": "USD"
  }
}

{
  "model": "muse-ember-1.0",
  "system_prompt": "",
  "display_name": "Muse Ember (< 200k)",
  "provider_ref": "meta",
  "context_length": 200000,
  "supports_structured_output": true,
  "max_image_embeds": 50,
  "parameters": {
    "reasoning_effort": {
      "type": "enum",
      "options": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "default": "medium",
      "label": "Reasoning Effort",
      "description": "Controls how much reasoning the model performs. Reasoning cannot be turned off."
    },
    "temperature": {
      "type": "float",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1,
      "label": "Temperature",
      "description": "Controls randomness."
    },
    "max_completion_tokens": {
      "type": "int",
      "min": 32,
      "max": 524288,
      "step": 1,
      "default": 32768,
      "label": "Max completion tokens",
      "description": "Upper bound on generated tokens, including reasoning tokens."
    }
  },
  "pricing": {
    "input_per_1m_tokens": 0.1,
    "cached_input_per_1m_tokens": 0.004,
    "output_per_1m_tokens": 0.5,
    "currency": "USD"
  }
}

{
  "model": "gemini-3-flash-preview",
  "system_prompt": "",
  "display_name": "Gemini 3 Flash(有料Tier)",
  "provider_ref": "gemini",
  "context_length": 1000000,
  "default_max_history_messages": 80,
  "metabolism_keep_messages": 60,
  "supports_images": true,
  "supports_audio": true,
  "supports_video": true,
  "prefer_paid": true,
  "pricing": {
    "input_per_1m_tokens": 0.5,
    "cached_input_per_1m_tokens": 0.05,
    "output_per_1m_tokens": 3.0,
    "currency": "USD"
  },
  "parameters": {
    "temperature": {
      "type": "slider",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1.0,
      "label": "Temperature",
      "description": "出力のランダム性。0で決定的、高いほど多様。"
    },
    "thinking_level": {
      "type": "dropdown",
      "options": [
        "minimal",
        "low",
        "medium",
        "high"
      ],
      "default": "minimal",
      "label": "Thinking Level",
      "description": "思考の深さ。minimalで高速・安定、highで深い推論。空応答対策にはminimalを推奨。"
    },
    "thought_signature_echo": {
      "type": "dropdown",
      "options": ["on", "off"],
      "default": "on",
      "label": "思考署名の引き継ぎ",
      "description": "モデルが返す思考署名 (thought signature) を次ターンに載せ直すか。onで関数呼び出しの連続性を維持。offでキャッシュ効率が上がる(3.x系では関数呼び出しパートの署名は常に引き継がれ、テキストパートの署名のみoffで止まる)。"
    },
    "safety_harassment": {
      "type": "dropdown",
      "options": [
        "BLOCK_NONE",
        "BLOCK_ONLY_HIGH",
        "BLOCK_MEDIUM_AND_ABOVE",
        "BLOCK_LOW_AND_ABOVE"
      ],
      "default": "BLOCK_NONE",
      "label": "Safety: Harassment"
    },
    "safety_hate_speech": {
      "type": "dropdown",
      "options": [
        "BLOCK_NONE",
        "BLOCK_ONLY_HIGH",
        "BLOCK_MEDIUM_AND_ABOVE",
        "BLOCK_LOW_AND_ABOVE"
      ],
      "default": "BLOCK_ONLY_HIGH",
      "label": "Safety: Hate Speech"
    },
    "safety_sexually_explicit": {
      "type": "dropdown",
      "options": [
        "BLOCK_NONE",
        "BLOCK_ONLY_HIGH",
        "BLOCK_MEDIUM_AND_ABOVE",
        "BLOCK_LOW_AND_ABOVE"
      ],
      "default": "BLOCK_NONE",
      "label": "Safety: Sexually Explicit"
    },
    "safety_dangerous_content": {
      "type": "dropdown",
      "options": [
        "BLOCK_NONE",
        "BLOCK_ONLY_HIGH",
        "BLOCK_MEDIUM_AND_ABOVE",
        "BLOCK_LOW_AND_ABOVE"
      ],
      "default": "BLOCK_ONLY_HIGH",
      "label": "Safety: Dangerous Content"
    }
  }
}
    "input_per_1m_tokens": 0.15,
    "cached_input_per_1m_tokens": 0.0375,
    "output_per_1m_tokens": 0.6,
    "currency": "USD"
  },
  "parameters": {
    "temperature": {
      "type": "slider",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1.0,
      "label": "Temperature",
      "description": "出力のランダム性。0で決定的、高いほど多様。"
    },
    "thinking_budget": {
      "type": "dropdown",
      "options": [
        "default",

        "1024",
        "4096",
        "8192",
        "16384",
        "24576"
      ],
      "default": "24576",
      "label": "Thinking Budget",
      "description": "思考トークン予算。defaultで思考なし。数値で思考を有効化し予算を指定(512〜24576)。"
    },
    "thought_signature_echo": {
      "type": "dropdown",
      "options": ["on", "off"],
      "default": "on",
      "label": "思考署名の引き継ぎ",
      "description": "モデルが返す思考署名 (thought signature) を次ターンに載せ直すか。onで関数呼び出しの連続性を維持。offでキャッシュ効率が上がる(3.x系では関数呼び出しパートの署名は常に引き継がれ、テキストパートの署名のみoffで止まる)。"
    },
    "safety_harassment": {

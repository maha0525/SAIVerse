      "type": "float",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "default": 0.2,
      "label": "Temperature",
      "description": "Controls randomness."
    },
    "top_p": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 1,
      "label": "Top P",
      "description": "Nucleus sampling cutoff."
    },
    "max_tokens": {
      "type": "int",
      "min": 32,
      "max": 260000,
      "step": 1,
      "default": 8000,
      "label": "Max tokens",
      "description": "Upper bound on generated tokens."
    }
  }
}

{
  "model": "qwen/qwen3-coder:free",
  "system_prompt": "",
  "display_name": "Qwen 3 Coder (Open Router, Free)",
  "provider_ref": "openrouter",
  "group": "openrouter",
  "supports_structured_output": true,
  "context_length": 250000,
  "convert_system_to_user": true,
  "supports_images": false,
  "parameters": {
    "temperature": {
      "type": "float",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "default": 0.7,
      "label": "Temperature",
      "description": "Controls randomness."
    },
    "top_p": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.8,
      "label": "Top P",
      "description": "Nucleus sampling cutoff."
    },
    "max_tokens": {
      "type": "int",
      "min": 32,
      "max": 260000,
      "step": 1,
      "default": 8000,
      "label": "Max tokens",
      "description": "Upper bound on generated tokens."
    }
  }
}
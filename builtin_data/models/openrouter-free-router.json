{
  "model": "openrouter/free",
  "system_prompt": "",
  "display_name": "Free Models Router (OpenRouter, Free / 無料モデルを自動選択)",
  "provider_ref": "openrouter",
  "group": "openrouter",
  "supports_structured_output": true,
  "context_length": 200000,
  "convert_system_to_user": true,
  "supports_images": true,
  "max_image_bytes": 7500000,
  "max_image_embeds": 4,
  "request_kwargs": {
    "extra_body": {
      "provider": {
        "require_parameters": true
      }
    }
  },
  "parameters": {
    "temperature": {
      "type": "float",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 0.7,
      "label": "Temperature",
      "description": "Controls randomness."
    },
    "top_p": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.95,
      "label": "Top P",
      "description": "Nucleus sampling cutoff."
    },
    "max_tokens": {
      "type": "int",
      "min": 32,
      "max": 65536,
      "step": 1,
      "default": 8192,
      "label": "Max tokens",
      "description": "Upper bound on generated tokens."
    }
  }
}

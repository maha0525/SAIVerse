{
  "model": "qwen/qwen3.7-max",
  "system_prompt": "",
  "display_name": "Qwen3.7 Max (OpenRouter)",
  "provider_ref": "openrouter",
  "group": "openrouter",
  "supports_structured_output": true,
  "context_length": 1000000,
  "default_max_history_messages": 80,
  "metabolism_keep_messages": 60,
  "convert_system_to_user": true,
  "supports_images": false,
  "reasoning_passback_field": "reasoning_details",
  "request_kwargs": {
    "extra_body": {
      "reasoning": {
        "enabled": true
      }
    }
  },
  "parameters": {
    "temperature": {
      "type": "float",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 0.7,
      "label": "Temperature",
      "description": "Controls randomness."
    },
    "top_p": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.8,
      "label": "Top P",
      "description": "Nucleus sampling cutoff."
    },
    "max_tokens": {
      "type": "int",
      "min": 32,
      "max": 65536,
      "step": 1,
      "default": 8192,
      "label": "Max tokens",
      "description": "Upper bound on generated tokens."
    }
  },
  "pricing": {
    "input_per_1m_tokens": 1.25,
    "cached_input_per_1m_tokens": 0.25,
    "output_per_1m_tokens": 3.75,
    "currency": "USD"
  }
}

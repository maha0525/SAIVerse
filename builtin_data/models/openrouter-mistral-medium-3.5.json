{
  "model": "mistralai/mistral-medium-3-5",
  "system_prompt": "",
  "display_name": "Mistral Medium 3.5 (OpenRouter)",
  "provider_ref": "openrouter",
  "group": "openrouter",
  "supports_structured_output": true,
  "context_length": 262144,
  "default_max_history_messages": 80,
  "metabolism_keep_messages": 60,
  "convert_system_to_user": true,
  "supports_images": true,
  "max_image_bytes": 7500000,
  "max_image_embeds": 4,
  "reasoning_passback_field": "reasoning_details",
  "request_kwargs": {
    "extra_body": {
      "reasoning": {
        "enabled": true
      }
    }
  },
  "parameters": {
    "temperature": {
      "type": "float",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1.0,
      "label": "Temperature",
      "description": "Controls randomness."
    },
    "top_p": {
      "type": "float",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.95,
      "label": "Top P",
      "description": "Nucleus sampling cutoff."
    },
    "max_tokens": {
      "type": "int",
      "min": 32,
      "max": 65536,
      "step": 1,
      "default": 8192,
      "label": "Max tokens",
      "description": "Upper bound on generated tokens."
    }
  },
  "pricing": {
    "input_per_1m_tokens": 1.5,
    "output_per_1m_tokens": 7.5,
    "currency": "USD"
  }
}
